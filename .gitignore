# Local Vector Store
index.faiss
metadata.pkl

# Data — raw ingestion corpus, not needed at runtime; keep local-only.
# The app reads from Qdrant, never from these; they are only inputs to
# `python -m app.ingestion.processor`. downloaded_data/ is ~2.9 MB of .pptx/.docx
# and belongs in the same bucket as crawled_data/.
DATA/
processed_data/
notebooks/
crawled_data/
downloaded_data/


