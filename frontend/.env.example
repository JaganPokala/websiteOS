# Base URL of the FastAPI backend.
#
# Vite inlines VITE_* variables at BUILD time — changing this after
# `npm run build` has no effect. Set it before building for production:
#   VITE_API_BASE_URL=https://your-backend.onrender.com npm run build
#
# Leave unset for local dev; api.js falls back to http://127.0.0.1:8000.
VITE_API_BASE_URL=
